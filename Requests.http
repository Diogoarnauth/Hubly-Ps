### Variáveis de Ambiente
@hostname = localhost
@port = 80
@host = {{hostname}}:{{port}}
@contentType = application/json
@token= fKaYqwErg9c8lXDRJldY84OEbZs3PY+hRATJA4xBYPA=

### 1. Criar um Novo Utilizador
POST http://{{host}}/api/users
Content-Type: {{contentType}}

{
    "name": "Bananinha Coisinha",
    "email": "Bananinha1234@example.com",
    "password": "PasswordSegura123"
}

### 2. Login (Obter Token e Set-Cookie)
POST http://{{host}}/api/users/token
Content-Type: {{contentType}}

{
    "email": "Bananinha1234@example.com",
    "password": "PasswordSegura123"
}

### 3. Logout 
POST http://{{host}}/api/users/logout
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

### 4. Get user info
GET http://{{host}}/api/users/1
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

### 5. Editar user
POST http://{{host}}/api/users/edit
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
    "newUsername": "banana"
}

### 5. Editar password
POST http://{{host}}/api/users/changePassword
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
    "OldPassword": "PasswordSegura123",
    "NewPassword": "PassworInsegura123"
}


### 6. Verificar Email
POST http://{{host}}/api/users/verifyEmail
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
    "email": "Bananinha1234@example.com",
    "code": "591376" 
}

### 7. Reenviar Confirmação de Email
POST http://{{host}}/api/users/resendEmailConfirmation
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
    "email": "Bananinha1234@example.com"
}

### Register Creator
POST http://{{host}}/api/creator
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "artisticName": "Windohhhh"
}

### Register Company
POST http://{{host}}/api/company
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "CompanySize": 1000,
  "CompanyName": "Primor",
  "Description": "This is the world largest company",
  "Sector": "Beauty",
  "WebsiteLink": "https://fr.primor.eu/fr_fr/",
  "CountryHeadquarters": "France"
}

   
