### Variáveis de Ambiente
@hostname = localhost
@port = 80
@host = {{hostname}}:{{port}}
@contentType = application/json
@token= /b4MZRDMAxrax+9ayAiLakco57vANajv164/5iDLjw0=


### 1. Criar um Novo Utilizador
POST http://{{host}}/api/users
Content-Type: {{contentType}}

{
    "name": "João Silva",
    "email": "joao.silva@example.com",
    "password": "PasswordSegura123"
}

### 2. Login (Obter Token e Set-Cookie)
POST http://{{host}}/api/users/token
Content-Type: {{contentType}}

{
    "email": "joao.silva@example.com",
    "password": "PasswordSegura123"
}

### 3. Logout 
POST http://{{host}}/api/users/logout
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

### 4. Get user info
GET http://{{host}}/api/users/1
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

### 5. Editar user
POST http://{{host}}/api/users/edit
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
    "newUsername": "joaozitofofitogodito"
}